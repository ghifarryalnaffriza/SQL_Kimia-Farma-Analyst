-- =========================================================
-- Cek jumlah data
-- =========================================================
SELECT 'transaction' AS tabel, COUNT(*) AS total_baris FROM bronze.kf_final_transaction
UNION ALL SELECT 'inventory',     COUNT(*) FROM bronze.kf_inventory
UNION ALL SELECT 'kantor_cabang', COUNT(*) FROM bronze.kf_kantor_cabang
UNION ALL SELECT 'product',       COUNT(*) FROM bronze.kf_product;
GO
 
-- =========================================================
-- Cek isi data
-- =========================================================
SELECT TOP 100 * FROM bronze.kf_final_transaction;
SELECT TOP 100 * FROM bronze.kf_inventory;
SELECT TOP 100 * FROM bronze.kf_kantor_cabang;
SELECT TOP 100 * FROM bronze.kf_product;
GO
